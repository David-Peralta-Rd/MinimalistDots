(defpoll time :interval "1s"
  `date +%H:%M:%S`)

(defwidget clock []
  (box :class "clock-widget" :orientation "v" :space-evenly false
    (label :text time :font-size "40px")))

(defwindow desktop_clock
  :monitor 0
  :geometry (geometry :x "20px"
                      :y "20px"
                      :width "200px"
                      :height "80px"
                      :anchor "top right")
  :stacking "bottom"
  :focusable false
  (clock))

