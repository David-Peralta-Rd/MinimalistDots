# ~/.config/ai/models.env  (sintaxis bash)
#
# Fuente única de modelos, puertos, hilos y contexto para el arranque sin menús
# (ai-up / llm_menu.sh up), para Continue y para los agentes. Si Continue ya
# apunta a otros puertos, cambia los valores AQUÍ y no la extensión de VS Code.
# El menú de SUPER+ALT+SHIFT+L también respeta los puertos, hilos y GPU de este archivo.
#
# llama-server se toma del PATH (paquete llama-cpp); los .gguf que baja el menú
# caen en ~/models, que es donde apuntan estas rutas.

# --- Chat / agente (el tool calling necesita --jinja; ya va puesto) ---
# Modelo por defecto de ai-up / ai-config. OpenCode (ai-code) YA NO lo usa: pregunta qué
# modelo abrir entre los descargados. Aquí va uno ligero (~5 GB); el de 30B pide ~20 GB.
CHAT_MODEL="$HOME/models/Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf"
CHAT_PORT=8080
CHAT_CTX=16384          # tokens; el KV cache crece con este valor, vigila la RAM (32768 solo si te sobra)
THREADS=6               # núcleos físicos del Ryzen 5 5600G; compara 6 vs 12 con: ai-bench

# --- Autocompletado (FIM) ---
FIM_MODEL="$HOME/models/qwen2.5-coder-1.5b-q8_0.gguf"
FIM_PORT=8081
FIM_CTX=4096
FIM_THREADS=2

# Capas a la GPU: 0 = solo CPU y sin inicializar Vulkan (recomendado: la Vega
# comparte la RAM y suele dar "device lost"). Súbelo solo si MEDISTE una mejora.
NGL=0
