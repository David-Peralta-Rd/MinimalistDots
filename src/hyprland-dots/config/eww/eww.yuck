(defpoll time_clock :interval "30s" "date +%H:%M")
;; Convertimos la salida de la fecha a minúsculas de forma nativa
(defpoll date_clock :interval "30s" "date +'%a, %d %b' | tr 'A-Z' 'a-z'")

(defwidget clock []
  (box :class "clock-card" 
       :orientation "v" 
       :space-evenly false
       :halign "end"
    (label :class "clock-time" :text time_clock :halign "end")
    (label :class "clock-date" :text date_clock :halign "end")))

(defwindow desktop_clock
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "40px"          ;; Distancia respecto al borde superior
                      :width "280px" 
                      :height "120px"
                      :anchor "left center") ;; Anclaje al centro izquierdo
  :stacking "bottom"
  :focusable false
  (clock))


;; ============================================================
;; POMODORO  (lo controla ~/.local/bin/MinimalistDots/scripts/pomodoro.sh)
;; El script va actualizando estas variables cada segundo con `eww update`.
;; Minimalista: minutos restantes, sesión, una barra fina y 3 botones en columna a la derecha.
;; ============================================================
(defvar pomo_time    "0")       ;; minutos restantes ("24") o, en el último minuto, segundos (":45")
(defvar pomo_pct     "100")     ;; % de la fase que queda (0-100)
(defvar pomo_session "1/1")     ;; sesión actual / total
(defvar pomo_class   "focus")   ;; focus | break | paused  (color de la barra)
(defvar pomo_icon    "❚❚")      ;; ❚❚ pausar  |  ▶ reanudar

(defwidget pomodoro []
  ;; eventbox: el :hover del CSS detecta el mouse y los clics controlan el pomodoro
  (eventbox :class "pomo-card"
            :tooltip "Clic: pausa / reanudar  ·  Clic derecho: reiniciar fase  ·  Clic medio: detener"
            :onclick       "$HOME/.local/bin/MinimalistDots/scripts/pomodoro.sh pause"
            :onrightclick  "$HOME/.local/bin/MinimalistDots/scripts/pomodoro.sh restart"
            :onmiddleclick "$HOME/.local/bin/MinimalistDots/scripts/pomodoro.sh stop"
    (box :orientation "h" :space-evenly false :spacing 6 :halign "center" :valign "center"

      ;; --- Contenido: número, sesión y barra ---
      (box :orientation "v" :space-evenly false :spacing 3 :halign "center" :valign "center"
        (label :class "pomo-time ${pomo_class}" :text pomo_time)
        (label :class "pomo-session" :text pomo_session)
        ;; Barra de progreso: la pista mide 30px (ver .pomo-track en eww.css)
        (box :class "pomo-track" :orientation "h" :space-evenly false
          (box :class "pomo-fill ${pomo_class}"
               :halign "start"
               :style "min-width: ${round(pomo_pct * 30 / 100, 0)}px;")))

      ;; --- Botones en columna (pausa/reanudar, reiniciar fase, detener) ---
      (box :class "pomo-controls" :orientation "v" :space-evenly true
        (button :class "pomo-btn"
                :onclick "$HOME/.local/bin/MinimalistDots/scripts/pomodoro.sh pause"
          (label :text pomo_icon))
        (button :class "pomo-btn"
                :onclick "$HOME/.local/bin/MinimalistDots/scripts/pomodoro.sh restart"
          (label :text "↻"))
        (button :class "pomo-btn"
                :onclick "$HOME/.local/bin/MinimalistDots/scripts/pomodoro.sh stop"
          (label :text "✕"))))))

;; Abajo al centro. y = gaps_out de Hyprland (6px) para quedar alineado con el borde de las ventanas.
;; Es una capa superpuesta: no reserva espacio ni mueve tus ventanas.
(defwindow pomodoro
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "6px"
                      :width "80px"
                      :height "50px"
                      :anchor "bottom center")
  :stacking "fg"
  :focusable false
  (pomodoro))
